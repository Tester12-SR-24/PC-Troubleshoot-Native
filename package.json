{
  "name": "pc-troubleshoot",
  "version": "0.1.1",
  "private": true,
  "desktopName": "PC Signal",
  "license": "WTFPL",
  "author": "PC Troubleshoot",
  "description": "Local-first cross-platform PC monitoring and troubleshooting",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:desktop": "electron .",
    "package:linux": "bash scripts/package-linux.sh",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.pctroubleshoot.desktop",
    "productName": "PC Troubleshoot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**",
      "ui/**",
      "assets/**",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "executableName": "pc-troubleshoot",
      "syncDesktopName": true,
      "category": "System",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "PC-Troubleshoot-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icon.svg",
      "target": [
        "nsis"
      ],
      "artifactName": "PC-Troubleshoot-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
